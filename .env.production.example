# ============================================================
#  VELOR — production .env  (ОБРАЗЕЦ)
#  Скопируй в файл .env на сервере и впиши свои значения.
#  Файл .env никому не показывай и не клади в git.
# ============================================================

# ---------- Домен и HTTPS ----------
DOMAIN=velorai.tech
LETSENCRYPT_EMAIL=arinashevchenko265@gmail.com

# ---------- Окружение ----------
# production включает жёсткие проверки (запрет стандартных паролей владельца).
APP_ENV=production

# ---------- Вход владельца VELOR ----------
# ОБЯЗАТЕЛЬНО смени. Пароль — не менее 6 символов, не из стандартных.
OWNER_LOGIN=смени_логин
OWNER_PASSWORD=смени_на_надёжный_пароль

# ---------- Секрет подписи токенов ----------
# Сгенерируй свой:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=вставь_длинную_случайную_строку
ACCESS_TTL_MIN=30
REFRESH_TTL_DAYS=30

# ---------- Пути данных (внутри контейнера; менять не нужно) ----------
DB_PATH=/app/data/assistant.db
LOG_DIR=/app/logs

# ---------- Ключи ИИ ----------
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-4-8
GIGACHAT_AUTH_KEY=ключ_гигачата

# ---------- Telegram ----------
# Токены ботов обычно задаются каждому бизнесу в кабинете. Эти два — для
# единственного «демо»-бота из .env (необязательно):
TELEGRAM_TOKEN=
DEMO_BOT_BUSINESS_ID=

# ---------- Защита от перебора (можно не трогать) ----------
LOGIN_MAX_FAILS=8
LOGIN_FAIL_WINDOW_MIN=15
LOGIN_BLOCK_MIN=15
REGISTER_MAX=5
REGISTER_WINDOW_MIN=60

# ---------- Резервное копирование ----------
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=14
