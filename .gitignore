# ВАЖНО: комментарии git читает ТОЛЬКО в начале строки. Нельзя писать
# «.env  # коммент» — тогда весь текст станет частью шаблона и правило не сработает.

# ---- Секреты: НИКОГДА не в репозиторий ----
.env
.env.*
.jwt_secret
# ...но шаблоны без секретов оставляем
!.env.example
!.env.production.example

# ---- Данные и логи (клиенты, заказы, трейсбеки) ----
*.db
*.log
data/
logs/
backups/
uploads/
certbot/

# ---- Временные файлы Python ----
__pycache__/
*.pyc

# ---- Другие проекты в этой же папке (не часть деплоя VELOR) ----
# У agents/ свой .env с токенами — тем более не в публичный репозиторий.
agents/
portfolio/
medsklad/

# ---- Локальные черновики и посторонние материалы ----
_render.html
_render_v.html
body.html
row.json
Kwork_*.md
kwork_*.svg
курс_*.md
карусель_*.html
ТЗ_*.md
Ссылка_для_друга.bat

# ---- Локальная конфигурация редактора/агента ----
.claude/
