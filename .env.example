# Это ОБРАЗЕЦ. Скопируй этот файл и назови копию просто  .env
# Потом впиши сюда свои настоящие ключи. Файл .env никому не показывай.

# Токен Telegram-бота. Где взять: напиши в Telegram боту @BotFather,
# команда /newbot — он выдаст строку вида 123456:AA....  Вставь её сюда.
TELEGRAM_TOKEN=сюда_вставь_токен_от_BotFather

# Ключ ИИ (Claude от Anthropic). Где взять: platform.claude.com → API Keys.
# Без него бот работает в простом режиме (анкета), а ядро на сайте
# отвечает заготовленными фразами.
ANTHROPIC_API_KEY=сюда_вставь_ключ_sk-ant-...

# Модель ИИ. claude-opus-4-8 — самая умная (дороже),
# claude-haiku-4-5 — быстрая и дешёвая (для старта хватает).
CLAUDE_MODEL=claude-opus-4-8

# GigaChat (Сбер) — российская альтернатива Claude. Ключ авторизации
# из кабинета developers.sber.ru (тариф Freemium — бесплатно).
GIGACHAT_AUTH_KEY=сюда_вставь_ключ_гигачата

# Google Gemini — ОСНОВНОЙ провайдер, если задан ключ (GigaChat становится
# страховкой с автооткатом). Через OpenAI-совместимый эндпоинт: для официального
# Google оставь GEMINI_BASE_URL как есть; для реселлера/прокси впиши их URL.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# (Необязательно) Postgres вместо локального SQLite. Если оставить пусто —
# используется файл assistant.db рядом с проектом. Для боевого хранилища задай
# строку Supabase: postgresql://USER:PASSWORD@HOST:6543/postgres
DATABASE_URL=

# ---------- Instagram как канал (директ) ----------
# Одно приложение Meta на всю платформу: бизнесы входят в него своими аккаунтами
# Instagram. Пока эти три строки пусты, канал честно показан выключенным —
# кнопка «Подключить» не работает и никакого экрана входа не рисуется.
#
# Где взять: developers.facebook.com → создать приложение → продукт
# «Instagram» → «Instagram API с Instagram Login». В настройках приложения
# укажи:
#   Адрес возврата (OAuth Redirect URI) — PUBLIC_URL + /api/instagram/callback
#   Адрес вебхука (Callback URL)        — PUBLIC_URL + /api/instagram/webhook
#   Проверочное слово (Verify Token)    — INSTAGRAM_VERIFY_TOKEN (см. ниже)
# Подписка на поля: messages, message_echoes, messaging_seen.
# Аккаунт бизнеса должен быть профессиональным (бизнес или автор). Для чужих
# аккаунтов Meta требует App Review и подтверждение компании; без него работают
# до 25 тестовых пользователей.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Проверочное слово вебхука. Можно оставить пустым — тогда оно выводится из
# ключа подписи сервера и его видно владельцу VELOR в разделе «Директ».
# Задавай явно, если SECRET_KEY может смениться: иначе Meta перестанет
# проходить проверку адреса.
INSTAGRAM_VERIFY_TOKEN=

# Адрес возврата, если он отличается от PUBLIC_URL + /api/instagram/callback.
# Meta сверяет его посимвольно.
INSTAGRAM_REDIRECT_URI=

# Публичный адрес сервиса (на Render подставляется сам через RENDER_EXTERNAL_URL).
# Без него Instagram подключить нельзя: некуда возвращать и некуда звонить.
PUBLIC_URL=

# ---------- Вход владельца VELOR (личный кабинет) ----------
# ОБЯЗАТЕЛЬНО поменяй перед публикацией. Если оставить admin/admin (или пустой/
# короткий пароль), сервер в режиме разработки предупредит, а в production
# (APP_ENV=production) вообще НЕ запустится. Пароль — минимум 6 символов.
OWNER_LOGIN=придумай_логин
OWNER_PASSWORD=придумай_надёжный_пароль

# Окружение: development (по умолчанию, для локальной работы) или production
# (боевой сервер — включает запрет запуска со стандартными паролями).
APP_ENV=development
