# Это ОБРАЗЕЦ. Скопируй этот файл и назови копию просто  .env
# Потом впиши сюда свои настоящие ключи. Файл .env никому не показывай.

# Токен Telegram-бота. Где взять: напиши в Telegram боту @BotFather,
# команда /newbot — он выдаст строку вида 123456:AA....  Вставь её сюда.
TELEGRAM_TOKEN=сюда_вставь_токен_от_BotFather

# Ключ ИИ (Claude от Anthropic). Где взять: platform.claude.com → API Keys.
# Без него бот работает в простом режиме (анкета), а ядро на сайте
# отвечает заготовленными фразами.
ANTHROPIC_API_KEY=сюда_вставь_ключ_sk-ant-...

# Модель ИИ. claude-opus-4-8 — самая умная (дороже),
# claude-haiku-4-5 — быстрая и дешёвая (для старта хватает).
CLAUDE_MODEL=claude-opus-4-8

# GigaChat (Сбер) — российская альтернатива Claude. Ключ авторизации
# из кабинета developers.sber.ru (тариф Freemium — бесплатно).
GIGACHAT_AUTH_KEY=сюда_вставь_ключ_гигачата

# (Необязательно) Postgres вместо локального SQLite. Если оставить пусто —
# используется файл assistant.db рядом с проектом. Для боевого хранилища задай
# строку Supabase: postgresql://USER:PASSWORD@HOST:6543/postgres
DATABASE_URL=

# ---------- Вход владельца VELOR (личный кабинет) ----------
# ОБЯЗАТЕЛЬНО поменяй перед публикацией. Если оставить admin/admin (или пустой/
# короткий пароль), сервер в режиме разработки предупредит, а в production
# (APP_ENV=production) вообще НЕ запустится. Пароль — минимум 6 символов.
OWNER_LOGIN=придумай_логин
OWNER_PASSWORD=придумай_надёжный_пароль

# Окружение: development (по умолчанию, для локальной работы) или production
# (боевой сервер — включает запрет запуска со стандартными паролями).
APP_ENV=development
